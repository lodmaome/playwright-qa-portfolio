{
  "name": "playwright-qa-portfolio",
  "version": "0.1.0",
  "description": "Playwright and TypeScript QA portfolio: UI, API, visual, accessibility, and config tests against SauceDemo and DummyJSON",
  "license": "MIT",
  "author": "lodmaome",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lodmaome/playwright-qa-portfolio.git"
  },
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "pretest": "node -e \"require('fs').rmSync('allure-results',{recursive:true,force:true});require('fs').rmSync('allure-report',{recursive:true,force:true})\"",
    "test": "playwright test",
    "posttest": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "report:allure": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report:playwright": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.9.3",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.13.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.11.0",
    "eslint-plugin-playwright": "^2.12.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "zod": "^4.6.5"
  }
}
